# Public demo placeholders only.
# Copy to .env.local for local development.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

APP_PASSWORD=replace-with-local-demo-password
ENCRYPTION_KEY=replace-with-64-character-hex-string

# At least one generation provider is required.
ANTHROPIC_API_KEY=replace-with-your-anthropic-key
OPENAI_API_KEY=replace-with-your-openai-key

# Optional web research.
SEARCH_API_KEY=replace-with-your-search-key
